# ===== Walking app 環境変数テンプレ =====
# このファイルをコピーして実ファイルを作り、値を埋める（実ファイルは Git 管理外）。
# EXPO_PUBLIC_ 接頭辞の付いた変数だけがアプリのバンドルに露出する（ADR-0012）。

# --- Notion 接続（クライアント／EXPO_PUBLIC_ はバンドルに露出する） ---

# データベースID（識別子・秘密ではない）。Notion DB の URL から取得。
EXPO_PUBLIC_NOTION_DB_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Notion インテグレーションのトークン。
#   - ネイティブ（iOS/Android）直叩き用にクライアントへ載せる場合のみ使う。
#   - web で proxy 経由にする場合は載せない（下の PROXY を使い、トークンはサーバ側へ）。
EXPO_PUBLIC_NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# proxy のベースURL。設定するとアプリはここを経由して Notion を叩く（ADR-0015 / 0016）。
#   - ローカル開発 : http://localhost:8787   （scripts/notion-proxy.ts を起動）
#   - 本番(Vercel) : /api/notion             （api/notion 関数。同一オリジンで CORS なし）
#   - ネイティブ直叩きに戻す : 空にする
EXPO_PUBLIC_NOTION_PROXY=http://localhost:8787

# --- proxy（サーバ側）が読む。EXPO_PUBLIC_ を付けない＝クライアントに露出しない ---

# Notion トークン（本命）。ローカル proxy / Vercel 関数がサーバ側で注入する。
# 本番は Vercel のダッシュボードでこの名前で設定する（ADR-0016）。
NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ローカル proxy の待受ポート（既定 8787）。
NOTION_PROXY_PORT=8787

# ローカル proxy が CORS 許可するオリジン（カンマ区切り・未設定なら localhost 系を自動許可）。
# NOTION_PROXY_ORIGINS=http://localhost:8081,http://localhost:8082
